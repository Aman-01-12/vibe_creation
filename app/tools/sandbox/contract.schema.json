{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ece.dev/schemas/sandbox-contract.json",
  "title": "Tool_Runner sandbox job/result contract",
  "definitions": {
    "SourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "contents"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "contents": {
          "type": "string"
        }
      }
    },
    "ResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memMb", "procs", "diskMb", "wallMs"],
      "properties": {
        "cpu": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memMb": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "procs": {
          "type": "integer",
          "minimum": 1
        },
        "diskMb": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "wallMs": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "RequiredOutput": {
      "type": "string",
      "enum": [
        "stdout",
        "stderr",
        "exitCode",
        "vcd",
        "netlistJson",
        "formalReport",
        "formalPrepassReport",
        "lintReport"
      ]
    },
    "FormalJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topModule", "depth"],
      "properties": {
        "topModule": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
          "maxLength": 128
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "FormalPrepassJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topModule"],
      "properties": {
        "topModule": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
          "maxLength": 128
        }
      }
    },
    "SimulateJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultTimescale"],
      "properties": {
        "defaultTimescale": {
          "type": "string",
          "enum": ["1ns/1ps"]
        }
      }
    },
    "SynthesizeJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topModule", "schematic"],
      "properties": {
        "topModule": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
          "maxLength": 128
        },
        "schematic": {
          "type": "boolean"
        }
      }
    },
    "LintJobRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topModule"],
      "properties": {
        "topModule": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$",
          "maxLength": 128
        }
      }
    },
    "SandboxJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workspaceFiles", "limits", "requiredOutputs"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["simulate", "synthesize", "formal", "formalPrepass", "lint"]
        },
        "workspaceFiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceFile"
          }
        },
        "limits": {
          "$ref": "#/definitions/ResourceLimits"
        },
        "requiredOutputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/RequiredOutput"
          }
        },
        "formal": {
          "$ref": "#/definitions/FormalJobRequest"
        },
        "formalPrepass": {
          "$ref": "#/definitions/FormalPrepassJobRequest"
        },
        "simulate": {
          "$ref": "#/definitions/SimulateJobRequest"
        },
        "synthesize": {
          "$ref": "#/definitions/SynthesizeJobRequest"
        },
        "lint": {
          "$ref": "#/definitions/LintJobRequest"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "formal"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["formal"],
            "properties": {
              "formal": true
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "formal": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "formalPrepass"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["formalPrepass"],
            "properties": {
              "formalPrepass": true
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "formalPrepass": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "simulate"
              }
            }
          },
          "then": {
            "type": "object"
          },
          "else": {
            "type": "object",
            "properties": {
              "simulate": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "synthesize"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["synthesize"],
            "properties": {
              "synthesize": true
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "synthesize": false
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "lint"
              }
            }
          },
          "then": {
            "type": "object",
            "required": ["lint"],
            "properties": {
              "lint": true
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "lint": false
            }
          }
        }
      ]
    },
    "ArtifactBlobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sizeBytes", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "DeniedOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "detail"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["filesystem", "network", "process"]
        },
        "detail": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      }
    },
    "ResourceUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallMs", "maxMemMb", "cpuMs"],
      "properties": {
        "wallMs": {
          "type": "number",
          "minimum": 0
        },
        "maxMemMb": {
          "type": "number",
          "minimum": 0
        },
        "cpuMs": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "SandboxResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "timedOut",
        "exitCode",
        "stdout",
        "stderr",
        "stdoutTruncated",
        "stderrTruncated",
        "diskLimitExceeded",
        "artifacts",
        "deniedOperations",
        "resourceUsage"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "error"]
        },
        "timedOut": {
          "type": "boolean"
        },
        "exitCode": {
          "type": ["integer", "null"]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "stdoutTruncated": {
          "type": "boolean"
        },
        "stderrTruncated": {
          "type": "boolean"
        },
        "diskLimitExceeded": {
          "type": "boolean"
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/ArtifactBlobRef"
          }
        },
        "deniedOperations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DeniedOperation"
          }
        },
        "resourceUsage": {
          "$ref": "#/definitions/ResourceUsage"
        }
      }
    }
  }
}
