{
  "name": "ece-creation-copilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ECE Creation Copilot monorepo. Dependencies flow inward only: web -> api -> agent -> {knowledge, tools} -> core.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "app/core",
    "app/knowledge",
    "app/tools",
    "app/agent",
    "app/api",
    "app/web",
    "app/eval",
    "app/test"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "eslint app scripts --max-warnings=0",
    "lint:boundaries": "eslint app --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "eval:gate": "node app/eval/dist/gate/cli.js",
    "eval:sweep": "node app/eval/dist/sweep/cli.js",
    "eval:grounding-confirmatory": "vitest run app/agent/roles/testbench/prompt-version.test.ts app/test/testbench-rtl-isolation.property.test.ts && node app/eval/dist/sweep/cli.js --config app/eval/sweep/sweep.config.grounding-confirmatory-v1.json",
    "eval:reportability-slice": "vitest run app/agent/roles/testbench/prompt-version.test.ts app/test/testbench-rtl-isolation.property.test.ts app/test/reportability-fixtures.test.ts && node app/eval/dist/sweep/cli.js --config app/eval/sweep/sweep.config.reportability-slice-v1.json",
    "eval:property-only": "node app/eval/dist/property-only/cli.js",
    "corpus:fetch": "node app/eval/dist/corpus/fetch-cli.js",
    "vault:manifest": "node scripts/vault-manifest.mjs",
    "vault:check": "node scripts/vault-manifest.mjs --check",
    "vault:digest": "node scripts/vault-manifest.mjs --digest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@typescript-eslint/parser": "8.62.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.8.0",
    "prettier": "3.9.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  }
}
