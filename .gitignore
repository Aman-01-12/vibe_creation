# Python virtual environment (Playwright lives here; recreate via uv)
.venv/

# Secrets — env files and mcp.json (holds a live FIRECRAWL_API_KEY), never commit
.env
.env.*
!.env.example
dump.vcd
.kiro
chipAgent

# The Credential_File and anything a refresh writes beside it, never commit
.secrets/
*.pem
*.key
.kiro/settings/mcp.json
# Credential_File directory (app/agent DEFAULT_CREDENTIAL_FILE = .secrets/bedrock-token). The
# whole directory, not the one filename: a refresh writes a sibling temp file and moves it in.
/.secrets/

# Obsidian knowledge vault: keep notes versioned, but never commit private/sensitive area or user-local UI state
chipAgent/_private/
chipAgent/.obsidian/workspace.json

# Ignore ONLY things nothing references at build time (no dangling-pointer effect):
#   exploration history, strategy/market/marketing docs, and the human index.
/agent-native-map/
/archive-exploration/
/scanner/
/product-ece/share/
/product-ece/00-INDEX.md
/product-ece/ECE-STUDENT-PLATFORM.md
/product-ece/ECE-CURRICULUM-ROADMAP.md
/product-ece/ECE-GTM-TOOLCHAIN-COMPETITORS.md
/product-ece/ECE-GTM-PLAYBOOKS.md
/product-ece/ECE-COMPETITORS-DEEPDIVE.md
/product-ece

# KEPT TRACKED on purpose (steering / AGENTS.md / hooks reference them — ignoring would break
# the build guardrails in fresh clones / CI / no-mistakes worktrees):
#   product-ece/ECE-CODE-QUALITY-STANDARDS.md, ECE-SECURITY-PERFORMANCE-RESILIENCE.md,
#   ECE-VERIFICATION-METHODOLOGY.md, ECE-KNOWLEDGE-ARCHITECTURE.md, ECE-PRD-v1.md,
#   ECE-PHILOSOPHY.md, ECE-TECH-DECISIONS.md, ECE-RELIABILITY-SELFHEALING.md,
#   ECE-IMPLEMENTATION-REFERENCES.md, ECE-OBSIDIAN-KNOWLEDGE-MEMORY.md, and the chipAgent/ vault
#   (chipAgent/_private/ + .obsidian/workspace.json remain ignored above).

# Eval corpora fetched at a pinned commit, never vendored (see app/eval/corpus/pinned-source.ts).
# Populated by `npm run corpus:fetch`; the commit hash is the integrity guarantee, so the
# third-party tree itself is deliberately not committed.
/.eval-corpus/
# Eval sweep (model bake-off) run artifacts: manifest.json, results.jsonl, summary.txt.
# Produced by `npm run eval:sweep`; these are run outputs, not source. Keep the ones you
# cite by copying them out of the tree deliberately.
/.eval-runs/

# Mutation-calibration cache. A DERIVED artifact: keyed by the pinned corpus commit, the
# mutation config, and the mutant wall cap, and recomputed on any miss. Committing it would
# ship a cache whose key can silently disagree with the checkout that reads it.
/.eval-cache/
# Design sandbox — throwaway UI/UX trial-and-error (promote to app/web when finalized)
/design-sandbox/

# Lavish review artifacts (scratch HTML)
/.lavish/

# OS / editor cruft
.DS_Store

# Node
node_modules/

# TypeScript build output (project references emit dist/ + .tsbuildinfo)
dist/
*.tsbuildinfo

# Gate caches, so prettier and eslint re-check only what changed
.eslintcache

# Python build/cache artifacts (Tool_Runner worker)
__pycache__/
*.egg-info/
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
uv.lock
build/

# Playwright test artifacts
/tmp/inspect.png
.eval-corpus/
# Measurement_Records produced by the formal measurement scripts (`npm run formal:anchors`,
# `formal:reset-derivation`). Run outputs rather than source, and nothing in app/ or scripts/
# reads this directory, so ignoring it has no dangling-pointer effect. Same rule as /.eval-runs/:
# copy a record out of the tree deliberately when you want to cite it.
/measurements/
# One-off analysis write-up, not referenced by any steering file, hook, or build step.
/PCB-VERIFICATION-ANALYSIS.md
