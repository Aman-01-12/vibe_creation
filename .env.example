# Environment template. Copy to `.env` and fill in real values.
#
# `.env` is gitignored; this template is the only env file that is committed, so
# it must never contain a real credential. Names only, no values.
# Every variable here is read from the environment at the point of use; none of
# them may appear in source, a config file, a prompt, a log, or a trace.

# Model provider credential for the OpenAI-compatible bedrock-mantle transport.
# Read only by app/agent/model-router/env-secret-manager.ts, and required by the
# eval sweep runner's preflight. One bearer token fronts the whole catalogue, so
# a per-role bake-off needs no additional credential. Secret.
AWS_BEARER_TOKEN_BEDROCK=

# Project_Store (Neon Postgres) configuration, read by
# app/api/project-store/postgres-adapter.ts. The connection string is a secret and
# is never logged; the residency region is not (OD-2, DPDP/GDPR).
PROJECT_STORE_DATABASE_URL=
PROJECT_STORE_DATA_RESIDENCY_REGION=

# Managed-auth adapter configuration, read by app/api/gateway/auth.ts. None of
# these are secrets, but all four are required: a partial auth configuration is
# refused rather than started.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URI=
AUTH_DATA_RESIDENCY_REGION=
